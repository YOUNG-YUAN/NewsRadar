# ==========================================
# 📡 NewsRadar 专有忽略规则 (高优先级)
# ==========================================

# 🌟 核心隐私保护：严禁上传包含 API Key 的配置文件
/data/

# 🌟 运行产物：日志与生成的简报报告无需同步
/logs/
/results/

# 🌟 个人备份与非代码设计文档
/backup/
*.pptx

# 🌟 虚拟环境：你本地的 venv 文件夹名为 NewsRadar
/NewsRadar/

# ==========================================
# 🐍 标准 Python 模板 (已根据本项目优化)
# ==========================================

# 字节码缓存文件
__pycache__/
*.py[codz]
*$py.class

# C 扩展库
*.so

# 打包与分发产物
.Python
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller 打包配置文件
*.manifest
*.spec

# 安装日志
pip-log.txt
pip-delete-this-directory.txt

# 单元测试与覆盖率报告
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/

# 翻译文件
*.mo
*.pot

# Django & Flask 等框架杂物 (本项目虽未使用，但保留以防万一)
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
instance/
.webassets-cache

# 文档构建产物
docs/_build/

# 开发环境设置
.env
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# 编辑器与 IDE 设置 (PyCharm / VS Code)
.idea/
.vscode/
*.swp
*.swo
tempCodeRunnerFile.py

# ==========================================
# 💡 发布后的关键提示
# ==========================================
# 由于我们忽略了整个 /data/ 文件夹，建议你在 /data/ 文件夹内
# 创建一个 config.json.example 文件并上传。
# 里面只放空的配置结构，方便其他用户知道如何填写 API Key。
