# ==========================================
# 📡 NewsRadar 极简精炼版忽略规则
# ==========================================

# 🌟 隐私护航 (绝对禁区)
/data/

# 🌟 运行数据与日志
/logs/
/results/
*.log

# 🌟 虚拟环境 (你的 venv 文件夹)
/NewsRadar/

# 🌟 打包产物与中间件
/build/
/dist/
*.spec

# 🌟 用户指定的“无关内容” (辅助/测试/遗留脚本)
fix_md_links.py
fix_messy_report.py
news_scraper.py
npr_scanner.py
test_news_scraper.py
test_rss.py
rescue_failed_chunks.py
md_to_pdf_batch.py
/backup/

# 🌟 图标源码与设计稿
icon.svg
GUI以及图标设计思路.pptx

# 🌟 环境引导脚本 (由 README 取代)
run.bat

# 忽略所有字体文件 (避免侵权及仓库臃肿)
fonts/*.ttf
fonts/*.ttc
fonts/*.otf

# 忽略个人草稿文件
structure.txt

# ==========================================
# 🐍 Python 标准环境清理
# ==========================================
__pycache__/
*.py[codz]
*$py.class
.idea/
.vscode/
tempCodeRunnerFile.py